{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mythic:crypto-provider:v1",
  "title": "Mythic crypto provider API v1",
  "description": "Plain JSON provider request/response and storage messages. AMQP uses Mythic authorization context headers. See README.md for correlation, byte limits, ownership, and atomic commit semantics.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "OpaqueBytes": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "Reference": {
      "type": "string",
      "maxLength": 1024,
      "description": "The Go validator applies a 1024 UTF-8 byte limit."
    },
    "StorageNamespace": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:/-]{1,128}$"
    },
    "StorageStateID": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:/-]{1,256}$"
    },
    "StorageRequestID": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:/-]{1,128}$"
    },
    "InputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "schemes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "establishment": {
          "const": "single_round"
        },
        "session_persistence": {
          "enum": [
            "durable",
            "volatile"
          ]
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "result_retention_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "api_version",
        "schemes",
        "establishment",
        "session_persistence",
        "max_message_bytes",
        "result_retention_seconds"
      ]
    },
    "Failure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "",
            "rejected",
            "unresolved"
          ],
          "description": "Rejected explicitly permits safe continuation; omitted or empty means unresolved for open/seal."
        }
      },
      "required": [
        "code"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/UUID"
        },
        "operation_scope_id": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "enum": [
            "describe",
            "prepare_profile",
            "begin_session",
            "open",
            "seal",
            "get_operation",
            "revoke_session"
          ]
        },
        "scheme": {
          "$ref": "#/$defs/Identifier"
        },
        "profile_ref": {
          "$ref": "#/$defs/Reference"
        },
        "session_ref": {
          "$ref": "#/$defs/Reference"
        },
        "namespace": {
          "$ref": "#/$defs/Reference"
        },
        "state_id": {
          "$ref": "#/$defs/Reference"
        },
        "payload_uuid": {
          "$ref": "#/$defs/UUID"
        },
        "next_uuid": {
          "$ref": "#/$defs/UUID"
        },
        "message": {
          "$ref": "#/$defs/OpaqueBytes"
        },
        "provider_json": {},
        "lookup_request_id": {
          "$ref": "#/$defs/UUID"
        },
        "auth_context": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "operation_scope_id",
        "method"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "prepare_profile"
              }
            }
          },
          "then": {
            "required": [
              "scheme"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "begin_session"
              }
            }
          },
          "then": {
            "required": [
              "profile_ref",
              "message",
              "payload_uuid",
              "next_uuid"
            ],
            "properties": {
              "profile_ref": {
                "minLength": 1
              },
              "message": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "open"
              }
            }
          },
          "then": {
            "required": [
              "session_ref",
              "namespace"
            ],
            "properties": {
              "session_ref": {
                "minLength": 1
              },
              "namespace": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "seal"
              }
            }
          },
          "then": {
            "required": [
              "session_ref",
              "namespace"
            ],
            "properties": {
              "session_ref": {
                "minLength": 1
              },
              "namespace": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "revoke_session"
              }
            }
          },
          "then": {
            "required": [
              "session_ref",
              "namespace"
            ],
            "properties": {
              "session_ref": {
                "minLength": 1
              },
              "namespace": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "get_operation"
              }
            }
          },
          "then": {
            "required": [
              "lookup_request_id"
            ]
          }
        }
      ]
    },
    "Response": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/UUID"
        },
        "operation_scope_id": {
          "type": "integer",
          "minimum": 1
        },
        "success": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/Failure"
        },
        "profile_ref": {
          "$ref": "#/$defs/Reference"
        },
        "session_ref": {
          "$ref": "#/$defs/Reference"
        },
        "namespace": {
          "$ref": "#/$defs/Reference"
        },
        "state_id": {
          "$ref": "#/$defs/Reference"
        },
        "message": {
          "$ref": "#/$defs/OpaqueBytes"
        },
        "agent_config": {
          "$ref": "#/$defs/OpaqueBytes"
        },
        "provider_json": {},
        "enc_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueBytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "dec_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueBytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "auth_context": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "operation_scope_id",
        "success"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "success": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        }
      ]
    },
    "StateKey": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        }
      },
      "required": [
        "namespace",
        "state_id"
      ]
    },
    "StoredState": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        },
        "state_blob": {
          "$ref": "#/$defs/OpaqueBytes"
        },
        "provider_json": {
          "type": "object",
          "default": {}
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "owner_epoch": {
          "$ref": "#/$defs/Revision"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "namespace",
        "state_id",
        "state_blob",
        "provider_json",
        "revision",
        "owner_epoch",
        "updated_at"
      ]
    },
    "CreateStateRequest": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        },
        "state_blob": {
          "$ref": "#/$defs/OpaqueBytes"
        },
        "provider_json": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "namespace",
        "state_id"
      ]
    },
    "AcquireStateRequest": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        },
        "expected_owner_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        }
      },
      "required": [
        "namespace",
        "state_id",
        "expected_owner_epoch"
      ]
    },
    "CommitStateRequest": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        },
        "request_id": {
          "$ref": "#/$defs/StorageRequestID"
        },
        "input_digest": {
          "$ref": "#/$defs/InputDigest"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        },
        "owner_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "state_blob": {
          "$ref": "#/$defs/OpaqueBytes"
        },
        "provider_json": {
          "type": "object",
          "default": {}
        },
        "result": {}
      },
      "required": [
        "namespace",
        "state_id",
        "request_id",
        "input_digest",
        "expected_revision",
        "owner_epoch",
        "result"
      ]
    },
    "LookupResultRequest": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        },
        "request_id": {
          "$ref": "#/$defs/StorageRequestID"
        },
        "input_digest": {
          "$ref": "#/$defs/InputDigest"
        }
      },
      "required": [
        "namespace",
        "state_id",
        "request_id",
        "input_digest"
      ]
    },
    "OperationResult": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/StorageNamespace"
        },
        "state_id": {
          "$ref": "#/$defs/StorageStateID"
        },
        "request_id": {
          "$ref": "#/$defs/StorageRequestID"
        },
        "input_digest": {
          "$ref": "#/$defs/InputDigest"
        },
        "result": {},
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "namespace",
        "state_id",
        "request_id",
        "input_digest",
        "result",
        "revision",
        "created_at"
      ]
    },
    "CommitResult": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "result": {},
        "cached": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "result",
        "cached"
      ]
    },
    "StorageRequest": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "provider_name": {
          "$ref": "#/$defs/Identifier"
        },
        "method": {
          "enum": [
            "load",
            "create",
            "acquire",
            "commit",
            "get_result"
          ]
        },
        "input": {
          "type": "object"
        },
        "request_id": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "provider_name",
        "method",
        "input"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "load"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/StateKey"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "create"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/CreateStateRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "acquire"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/AcquireStateRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "commit"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/CommitStateRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "get_result"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/LookupResultRequest"
              }
            }
          }
        }
      ]
    },
    "StorageResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": 1
            },
            "request_id": {
              "$ref": "#/$defs/UUID"
            },
            "provider_name": {
              "$ref": "#/$defs/Identifier"
            },
            "success": {
              "const": true
            },
            "result": {}
          },
          "required": [
            "api_version",
            "request_id",
            "provider_name",
            "success",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": 1
            },
            "request_id": {
              "$ref": "#/$defs/UUID"
            },
            "provider_name": {
              "$ref": "#/$defs/Identifier"
            },
            "success": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/StorageFailure"
            }
          },
          "required": [
            "api_version",
            "request_id",
            "provider_name",
            "success",
            "error"
          ]
        }
      ]
    },
    "StorageFailure": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "not_found",
            "already_exists",
            "stale_writer",
            "request_conflict",
            "internal_error",
            "unauthorized"
          ]
        },
        "message": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "",
            "rejected",
            "unresolved"
          ],
          "description": "Rejected explicitly permits safe continuation; omitted or empty means unresolved for open/seal."
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    },
    {
      "$ref": "#/$defs/StorageRequest"
    },
    {
      "$ref": "#/$defs/StorageResponse"
    }
  ]
}
